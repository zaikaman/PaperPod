# PaperPod Mobile / Web Client Environment Variables

# Backend API Base URL
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase Managed Backend
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# RevenueCat In-App Purchases (Dynamic Paywalls & Entitlements)
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_test_your_apple_api_key
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_test_your_google_api_key

# OneSignal Push Notifications
EXPO_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id_here
