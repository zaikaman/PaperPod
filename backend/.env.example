# PaperPod Backend Environment Variables

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000","*"]

# AI LLM Provider (Gemini 3.1 Flash Lite via OpenAI-Compatible Endpoint)
GEMINI_BASE_URL=https://cheapkeyai.shop/v1
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.7

# Supabase (Database, Auth, and Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Storage Bucket Names
STORAGE_BUCKET_PAPERS=papers
STORAGE_BUCKET_FIGURES=figures
STORAGE_BUCKET_AUDIO=audio

# Neural TTS Settings (Edge-TTS Microsoft Neural Voices)
TTS_VOICE_HOST_ALEX=en-US-GuyNeural
TTS_VOICE_HOST_TAYLOR=en-US-AriaNeural
TTS_VOICE_INTERRUPTION=en-US-AriaNeural

# RevenueCat Webhooks & Verification
REVENUECAT_WEBHOOK_AUTH_TOKEN=your_rc_webhook_secret_here

# OneSignal Push Notifications (Server REST API)
ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key_here
